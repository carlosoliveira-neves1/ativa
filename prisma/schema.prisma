// Prisma schema para o banco Postgres do Ativa NR-1
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model QuestionResponse {
  id             String   @id @default(uuid())
  sectionId      String
  questionId     String
  questionnaire  String   @default("")
  valueString    String?
  valueNumber    Float?
  attachmentName String?
  attachmentData String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sectionId])
  @@unique([questionnaire, sectionId, questionId], map: "responses_question_unique")
}

model SyncEntry {
  id          String   @id @default(uuid())
  timestamp   DateTime
  conformity  Float
  completion  Float
  note        String?
  createdAt   DateTime @default(now())
}

model ActionPlan {
  id                 String   @id @default(uuid())
  title              String
  problemDescription String
  normativeItem      String?
  unitOrSector       String?
  correctiveAction   String
  severity           String
  status             String
  dueDate            DateTime?
  responsible        String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([severity])
}
