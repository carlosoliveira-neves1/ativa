// Prisma schema para o banco Postgres do Ativa NR-1
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  ADMIN_GLOBAL
  COMPANY_ADMIN
  USER
}

model Company {
  id           String             @id @default(uuid())
  code         String             @unique
  nomeFantasia String
  razaoSocial  String
  cnpj         String             @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  users        User[]
  responses    QuestionResponse[]
  syncEntries  SyncEntry[]
  actionPlans  ActionPlan[]
  insights     CompanyInsight[]
}

model User {
  id                String          @id @default(uuid())
  name              String
  login             String          @unique
  email             String          @unique
  passwordHash      String
  role              UserRole        @default(USER)
  companyId         String?
  company           Company?        @relation(fields: [companyId], references: [id])
  questionnaireToken String?        @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  passwordResets    PasswordReset[]

  @@index([companyId])
  @@index([questionnaireToken])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model QuestionResponse {
  id             String   @id @default(uuid())
  sectionId      String
  questionId     String
  questionnaire  String   @default("")
  valueString    String?
  valueNumber    Float?
  attachmentName String?
  attachmentData String?
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([sectionId])
  @@unique([companyId, questionnaire, sectionId, questionId], map: "responses_company_question_unique")
}

model SyncEntry {
  id          String   @id @default(uuid())
  timestamp   DateTime
  conformity  Float
  completion  Float
  note        String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model ActionPlan {
  id                 String   @id @default(uuid())
  title              String
  problemDescription String
  normativeItem      String?
  unitOrSector       String?
  correctiveAction   String
  severity           String
  status             String
  dueDate            DateTime?
  responsible        String
  notes              String?
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([severity])
}

model CompanyInsight {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  suggestions String
  focus       String?
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}
