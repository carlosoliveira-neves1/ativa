# Frontend API URL
VITE_CLOUD_API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=prisma_shadow"

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=12h

# Auth
AUTH_SALT_ROUNDS=10
AUTH_MIN_PASSWORD_LENGTH=8

# AI
HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_MODEL=moonshotai/Kimi-K2-Instruct-0805
HUGGINGFACE_MAX_NEW_TOKENS=600
AI_SUGGESTION_LIMIT=5

# Email (SMTP)
# Porta 465 (SSL) ou 587 (TLS) - testar qual funciona melhor
SMTP_HOST=smtp.locaweb.com.br
SMTP_PORT=465
SMTP_USER=cadastro@infratechnologia.com.br
SMTP_PASS=Mudar@1234
SMTP_FROM=NR-1 Compliance <cadastro@infratechnologia.com.br>